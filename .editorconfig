; Единые правила набора текста для всех редакторов.
; Работают в момент печати, до запуска Prettier.
; https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

; В Markdown два пробела в конце строки означают перенос строки,
; поэтому здесь их обрезать нельзя.
[*.md]
trim_trailing_whitespace = false
